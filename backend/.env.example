# ⚠️ Copier vers backend/.env — ne jamais commiter backend/.env

SUPABASE_URL=https://VOTRE-PROJET.supabase.co
# Clé publishable (Dashboard → Settings → API → Publishable key)
SUPABASE_ANON_KEY=sb_publishable_...
# Clé secrète service_role (Dashboard → Settings → API → Secret key)
# UNIQUEMENT côté serveur — jamais dans admin/ ni frontend/
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

PORT=4000
UPLOAD_DIR=./uploads
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
