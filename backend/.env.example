# ⚠️ Copier vers backend/.env — ne jamais commiter backend/.env

# Environnement & Port
NODE_ENV=development
PORT=4000

# Configuration Supabase (Dashboard → Settings → API)
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=votre-cle-anon-publishable
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role-secrete

# Stockage & Options OCR
UPLOAD_DIR=./uploads
WARMUP_OCR=true

# Origines CORS autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://votre-domaine.com
